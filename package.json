{
  "name": "ruralcare",
  "version": "1.0.0",
  "description": "RuralCare: An Accessible Rural Healthcare Platform with Online Appointment Booking, Ambulance Assistance, and Offline Information Access",
  "main": "server/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"teal,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
  },
  "keywords": [
    "ruralcare",
    "healthcare",
    "rural-health",
    "mern",
    "pwa",
    "offline-first"
  ],
  "author": "RuralCare Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
